+    : public FusedElemwiseAddActivationOpTranscriber {
+  pir::OpInfo LoopkUpOpInfo(pir::IrContext* ctx,
+                            const OpDesc& op_desc) override {
+    const auto inter_out_grad = op_desc.Output("IntermediateOut@GRAD");
