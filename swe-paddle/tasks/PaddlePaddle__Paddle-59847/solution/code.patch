+class FractionalMaxPool2D(Layer):
+    r"""
+    This operation applies 2D fractional max pooling on input tensor, which is described in the paper:
+
+    [1] Ben Graham, Fractional Max-Pooling. 2015. http://arxiv.org/abs/1412.6071
