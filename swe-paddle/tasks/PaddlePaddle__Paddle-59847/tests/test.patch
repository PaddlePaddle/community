+class TestOutDtype(unittest.TestCase):
+    def test_max_pool(self):
+        api_fn = F.fractional_max_pool2d
+        shape = [1, 3, 32, 32]
+        check_out_dtype(
+            api_fn,
+            in_specs=[(shape,)],
+            expect_dtypes=['uint16', 'float16', 'float32', 'float64'],
+            output_size=16,
+        )
