+    def test_error_random_u(self):
+        for use_cuda in (
+            [False, True] if core.is_compiled_with_cuda() else [False]
+        ):
+            place, device = (
+                (paddle.CUDAPlace(0), 'gpu')
+                if use_cuda
+                else (paddle.CPUPlace(), 'cpu')
