diff --git a/test/legacy_test/test_max_pool_dilation_contract.py b/test/legacy_test/test_max_pool_dilation_contract.py
new file mode 100644
index 0000000..4231cd1
--- /dev/null
+++ b/test/legacy_test/test_max_pool_dilation_contract.py
@@ -0,0 +1,201 @@
+# Copyright (c) 2026 PaddlePaddle Authors. All Rights Reserved.
