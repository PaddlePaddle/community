+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+import paddle
+import paddle.nn.functional as F
+
+
+class TestMaxPoolDilationContract(unittest.TestCase):
+    def setUp(self):
+        paddle.disable_static()
+
+    def _check_functional_forward_and_backward(self, dimensions):
+        spatial_shape = [7] if dimensions == 1 else [5] * dimensions
+        shape = [1, 1, *spatial_shape]
+        input_np = np.arange(np.prod(shape), dtype="float32").reshape(shape)
+        x = paddle.to_tensor(input_np, stop_gradient=False)
+        pool = getattr(F, f"max_pool{dimensions}d")
+
+        out = pool(x, kernel_size=2, stride=1, dilation=2)
+        slices = (slice(None), slice(None), *([slice(2, None)] * dimensions))
+        expected = input_np[slices]
+        np.testing.assert_allclose(out.numpy(), expected)
+
+        out.sum().backward()
+        expected_grad = np.zeros_like(input_np)
+        expected_grad[slices] = 1
+        np.testing.assert_allclose(x.grad.numpy(), expected_grad)
+
+    def _check_layer_forward(self, dimensions):
+        spatial_shape = [7] if dimensions == 1 else [5] * dimensions
+        shape = [1, 1, *spatial_shape]
+        input_np = np.arange(np.prod(shape), dtype="float32").reshape(shape)
+        layer = getattr(paddle.nn, f"MaxPool{dimensions}D")(
+            kernel_size=2, stride=1, dilation=2
+        )
+        out = layer(paddle.to_tensor(input_np))
+        slices = (slice(None), slice(None), *([slice(2, None)] * dimensions))
+        np.testing.assert_allclose(out.numpy(), input_np[slices])
+
+    def _check_existing_positional_calls(self, dimensions):
+        shape = [1, 1, *([5] * dimensions)]
+        input_np = np.arange(np.prod(shape), dtype="float32").reshape(shape)
+        x = paddle.to_tensor(input_np)
+        functional = getattr(F, f"max_pool{dimensions}d")
+        layer_type = getattr(paddle.nn, f"MaxPool{dimensions}D")
+
+        functional_out, functional_mask = functional(
+            x, 2, 1, 0, True, False
+        )
+        layer_out, layer_mask = layer_type(2, 1, 0, True, False)(x)
+        slices = (slice(None), slice(None), *([slice(1, None)] * dimensions))
+        expected = input_np[slices]
+
+        np.testing.assert_allclose(functional_out.numpy(), expected)
+        np.testing.assert_allclose(layer_out.numpy(), expected)
+        np.testing.assert_array_equal(
+            functional_mask.numpy(), layer_mask.numpy()
+        )
+
+    def _check_compatibility_trap(self, dimensions):
+        shape = [1, 1, *([5] * dimensions)]
+        input_np = np.arange(np.prod(shape), dtype="float32").reshape(shape)
+        x = paddle.to_tensor(input_np)
+        functional = getattr(F, f"max_pool{dimensions}d")
+        layer_type = getattr(paddle.nn, f"MaxPool{dimensions}D")
+
+        paddle_functional = functional(x, 2, 1, 0, True, False, 2)
+        compatible_functional = functional(x, 2, 1, 0, 2, False, True)
+        alias_functional = functional(
+            input=x,
+            kernel_size=2,
+            stride=1,
+            padding=0,
+            dilation=2,
+            return_indices=True,
+        )
+
+        paddle_layer = layer_type(2, 1, 0, True, False, 2)(x)
+        compatible_layer = layer_type(2, 1, 0, 2, True, False)(x)
+        alias_layer = layer_type(
+            2, stride=1, padding=0, dilation=2, return_indices=True
+        )(x)
+
+        results = [
+            paddle_functional,
+            compatible_functional,
+            alias_functional,
+            paddle_layer,
+            compatible_layer,
+            alias_layer,
+        ]
+        slices = (slice(None), slice(None), *([slice(2, None)] * dimensions))
+        expected = input_np[slices]
+        expected_out, expected_mask = results[0]
+
+        np.testing.assert_allclose(expected_out.numpy(), expected)
+        for out, mask in results[1:]:
+            np.testing.assert_allclose(out.numpy(), expected)
+            np.testing.assert_array_equal(
+                mask.numpy(), expected_mask.numpy()
+            )
+
+    def test_functional_1d_forward_and_backward(self):
+        self._check_functional_forward_and_backward(1)
+
+    def test_functional_2d_forward_and_backward(self):
+        self._check_functional_forward_and_backward(2)
+
+    def test_functional_3d_forward_and_backward(self):
+        self._check_functional_forward_and_backward(3)
+
+    def test_layer_1d_forward(self):
+        self._check_layer_forward(1)
+
+    def test_layer_2d_forward(self):
+        self._check_layer_forward(2)
+
+    def test_layer_3d_forward(self):
+        self._check_layer_forward(3)
+
+    def test_asymmetric_dilation_2d(self):
+        input_np = np.arange(30, dtype="float32").reshape([1, 1, 5, 6])
+        x = paddle.to_tensor(input_np)
+        out = F.max_pool2d(
+            x, kernel_size=2, stride=1, dilation=[1, 2]
+        )
+        np.testing.assert_allclose(out.numpy(), input_np[:, :, 1:, 2:])
+
+    def test_static_2d_forward(self):
+        input_np = np.arange(25, dtype="float32").reshape([1, 1, 5, 5])
+        paddle.enable_static()
+        try:
+            main = paddle.static.Program()
+            startup = paddle.static.Program()
+            with paddle.static.program_guard(main, startup):
+                x = paddle.static.data(
+                    name="x", shape=input_np.shape, dtype="float32"
+                )
+                out = F.max_pool2d(
+                    x, kernel_size=2, stride=1, dilation=2
+                )
+
+            executor = paddle.static.Executor(paddle.CPUPlace())
+            executor.run(startup)
+            (result,) = executor.run(
+                main, feed={"x": input_np}, fetch_list=[out]
+            )
+            np.testing.assert_allclose(result, input_np[:, :, 2:, 2:])
+        finally:
+            paddle.disable_static()
+
+    def test_return_mask_and_ceil_mode(self):
+        x = paddle.arange(36, dtype="float32").reshape([1, 1, 6, 6])
+        out, mask = F.max_pool2d(
+            x,
+            kernel_size=2,
+            stride=2,
+            padding=1,
+            dilation=2,
+            return_mask=True,
+            ceil_mode=True,
+        )
+        self.assertEqual(out.shape, mask.shape)
+        self.assertEqual(list(out.shape), [1, 1, 4, 4])
+
+    def test_existing_positional_calls_1d(self):
+        self._check_existing_positional_calls(1)
+
+    def test_existing_positional_calls_2d(self):
+        self._check_existing_positional_calls(2)
+
+    def test_existing_positional_calls_3d(self):
+        self._check_existing_positional_calls(3)
+
+    def test_compatibility_trap_1d(self):
+        self._check_compatibility_trap(1)
+
+    def test_compatibility_trap_2d(self):
+        self._check_compatibility_trap(2)
+
+    def test_compatibility_trap_3d(self):
+        self._check_compatibility_trap(3)
+
+
+if __name__ == "__main__":
+    unittest.main()
