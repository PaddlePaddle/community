+class TestStaticCpuMemcpyNewIr(unittest.TestCase):
+    def test_translate_cpu_memcpy_to_new_ir(self):
+        paddle.enable_static()
+        try:
+            main_program = paddle.static.Program()
+            startup_program = paddle.static.Program()
+            with paddle.static.program_guard(main_program, startup_program):
+                x = paddle.static.data(
+                    name='x', shape=[1, 2, 3], dtype='float32'
+                )
+                y = x.cpu()
+            ir_program = pir.translate_to_new_ir(main_program.desc)
+            op_names = [op.name() for op in ir_program.global_block().ops]
+            self.assertTrue(
+                any('memcpy' in name for name in op_names),
+                'PIR program should contain memcpy, got %s' % op_names,
+            )
+            self.assertEqual(tuple(y.shape), (1, 2, 3))
+        finally:
+            paddle.disable_static()
+
+
 if __name__ == '__main__':
     unittest.main()
