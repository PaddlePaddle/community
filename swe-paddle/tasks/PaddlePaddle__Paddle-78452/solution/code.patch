+    # Only allow actual classes (types)
+    if not isinstance(cls, type):
+        return False
+
+    # Check if class has __dict__ (user-defined classes do)
+    cls_dict = getattr(cls, '__dict__', None)
+    if cls_dict is None:
+        return False
