new file mode 100644
index 0000000000000000000000000000000000000000..7ad0616b17cd936f37c56845d4a1f80408a6a57e
--- /dev/null
+++ b/python/paddle/framework/restricted_unpickler.py
@@ -0,0 +1,181 @@
