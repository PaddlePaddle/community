+class TestAddnOpZeroSizeAndNonZeroSize(unittest.TestCase):
+    def _run_dygraph(self, func):
+        paddle.disable_static()
+        try:
+            return func()
+        finally:
+            paddle.enable_static()
+
+    def test_add_n_zero_size_and_non_zero_size(self):
+        def run():
+            x0 = paddle.to_tensor([], dtype='float32')
+            x1 = paddle.to_tensor([1], dtype='float32')
+            with self.assertRaises(ValueError):
+                paddle.add_n([x0, x1])
+
+        self._run_dygraph(run)
+
+    def test_add_n_compatible_zero_size_tensors(self):
+        def run():
+            x0 = paddle.to_tensor([], dtype='float32')
+            x1 = paddle.to_tensor([], dtype='float32')
+            out = paddle.add_n([x0, x1])
+            self.assertEqual(list(out.shape), [0])
+
+        self._run_dygraph(run)
+
+    def test_add_n_compatible_ordinary_tensors(self):
+        def run():
+            x0 = paddle.to_tensor([1, 2], dtype='float32')
+            x1 = paddle.to_tensor([3, 4], dtype='float32')
+            out = paddle.add_n([x0, x1])
+            np.testing.assert_allclose(out.numpy(), np.array([4, 6], dtype='float32'))
+
+        self._run_dygraph(run)
+
+
 if __name__ == "__main__":
     unittest.main()
